          "stringUnit": {
            "state": "translated",
            "value": "Convierte documentos en papel, recibos y notas en PDF nítidos con búsqueda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Skannaa paperidokumentit, kuitit ja muistiinpanot teräviksi, haettaviksi PDF:iksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Numérisez vos documents papier, reçus et notes en PDF nets et interrogeables."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenirajte dokumente, račune i bilješke u oštre, pretražive PDF-ove."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvasd be a papíralapú dokumentumokat, nyugtákat és jegyzeteket éles, kereshető PDF-be."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona documenti cartacei, ricevute e appunti in PDF nitidi e ricercabili."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skann papirdokumenter, kvitteringer og notater til skarpe, søkbare PDF-er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan papieren documenten, bonnetjes en notities naar scherpe, doorzoekbare PDF's."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanuj dokumenty, paragony i notatki do ostrych PDF z wyszukiwaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie documentos em papel, recibos e anotações em PDFs nítidos e pesquisáveis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitalize documentos em papel, recibos e notas para PDF nítidos e pesquisáveis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanează documente pe hârtie, bonuri și notițe în PDF-uri clare și căutabile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканируйте документы, чеки и заметки в чёткие PDF с поиском по тексту."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenujte dokumenty, bločky a poznámky do ostrých, vyhľadávateľných PDF."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanna pappersdokument, kvitton och anteckningar till skarpa, sökbara PDF:er."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kâğıt belgeleri, fişleri ve notları net, aranabilir PDF’lere tarayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скануйте документи, чеки й нотатки в чіткі PDF із пошуком тексту."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qog‘oz hujjatlar, cheklar va qaydlarni aniq, qidiriladigan PDF’ga aylantiring."
          }
        }
      }
    },
