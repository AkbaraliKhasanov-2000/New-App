    "Documents in this folder will be moved to All Documents.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Документы из этой папки будут перемещены во «Все документы»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ushbu jilddagi hujjatlar «Barcha hujjatlar»ga ko‘chiriladi."
          }
        }
