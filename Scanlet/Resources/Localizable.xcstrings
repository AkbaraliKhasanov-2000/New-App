    "Plans are unavailable right now. Check your connection and try again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarify teď nejsou k dispozici. Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementer er ikke tilgængelige lige nu. Tjek din forbindelse, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abos sind gerade nicht verfügbar. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πακέτα δεν είναι διαθέσιμα τώρα. Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los planes no están disponibles ahora. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaukset eivät ole nyt saatavilla. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Offres indisponibles pour le moment. Vérifiez votre connexion et réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planovi trenutačno nisu dostupni. Provjerite vezu i pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csomagok most nem érhetők el. Ellenőrizd a kapcsolatot, és próbáld újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piani non disponibili al momento. Controlla la connessione e riprova."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementene er ikke tilgjengelige nå. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementen zijn nu niet beschikbaar. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plany są teraz niedostępne. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os planos não estão disponíveis agora. Verifique sua conexão e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os planos não estão disponíveis agora. Verifique a ligação e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Planurile nu sunt disponibile acum. Verifică conexiunea și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарифы сейчас недоступны. Проверьте подключение и попробуйте снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plány teraz nie sú dostupné. Skontrolujte pripojenie a skúste to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnemang är inte tillgängliga just nu. Kontrollera anslutningen och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlar şu anda kullanılamıyor. Bağlantınızı denetleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плани зараз недоступні. Перевірте з’єднання й повторіть спробу."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tariflar hozircha mavjud emas. Internetni tekshirib, qayta urinib ko‘ring."
          }
        }
      }
    },
