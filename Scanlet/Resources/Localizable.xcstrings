    "Plans are unavailable right now.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarify teď nejsou k dispozici."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πακέτα δεν είναι διαθέσιμα τώρα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los planes no están disponibles ahora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaukset eivät ole nyt saatavilla."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planovi trenutačno nisu dostupni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csomagok most nem érhetők el."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementene er ikke tilgjengelige nå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plany są teraz niedostępne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os planos não estão disponíveis agora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os planos não estão disponíveis agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарифы сейчас недоступны."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plány teraz nie sú dostupné."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плани зараз недоступні."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tariflar hozircha mavjud emas."
          }
        }
      }
    },
    "Plans are unavailable right now. Check your connection and try again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarify teď nejsou k dispozici. Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πακέτα δεν είναι διαθέσιμα τώρα. Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los planes no están disponibles ahora. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaukset eivät ole nyt saatavilla. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planovi trenutačno nisu dostupni. Provjerite vezu i pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csomagok most nem érhetők el. Ellenőrizd a kapcsolatot, és próbáld újra."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementene er ikke tilgjengelige nå. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plany są teraz niedostępne. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os planos não estão disponíveis agora. Verifique sua conexão e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os planos não estão disponíveis agora. Verifique a ligação e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарифы сейчас недоступны. Проверьте подключение и попробуйте снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plány teraz nie sú dostupné. Skontrolujte pripojenie a skúste to znova."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плани зараз недоступні. Перевірте з’єднання й повторіть спробу."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tariflar hozircha mavjud emas. Internetni tekshirib, qayta urinib ko‘ring."
          }
        }
      }
    },
