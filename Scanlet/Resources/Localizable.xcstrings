    "Try a sharper scan with good lighting, or pick recognition languages in Settings.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste ostřejší sken při dobrém světle nebo vyberte jazyky rozpoznávání v Nastavení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δοκιμάστε πιο καθαρή σάρωση με καλό φωτισμό ή επιλέξτε γλώσσες αναγνώρισης στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba con un escaneo más nítido y buena luz, o elige idiomas de reconocimiento en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile terävämpää skannausta hyvässä valossa tai valitse tunnistuskielet Asetuksissa."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokušajte s oštrijim skenom uz dobro svjetlo ili odaberite jezike prepoznavanja u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Próbálj élesebb beolvasást jó fényben, vagy válassz felismerési nyelveket a Beállításokban."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv en skarpere skanning i godt lys, eller velg gjenkjenningsspråk i Innstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrób ostrzejszy skan przy dobrym świetle lub wybierz języki rozpoznawania w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente escanear com mais nitidez e boa luz, ou escolha idiomas de reconhecimento nos Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente uma digitalização mais nítida com boa luz ou escolha os idiomas nas Definições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте более чёткий скан при хорошем освещении или выберите языки распознавания в настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skúste ostrejší sken pri dobrom svetle alebo vyberte jazyky rozpoznávania v Nastaveniach."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скануйте чіткіше при доброму світлі або виберіть мови розпізнавання в Параметрах."
          }
        },
