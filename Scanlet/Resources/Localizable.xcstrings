    "Double-tap to edit this page.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím dvakrát stránku upravíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobbelttryk for at redigere siden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Bearbeiten doppeltippen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγγίξτε δύο φορές για επεξεργασία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para editar la página."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muokkaa sivua kaksoisnapauttamalla."
          }
        },
        "fr": {
