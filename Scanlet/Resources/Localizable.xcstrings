    "Free for %@, then %@. Renews automatically until canceled. Cancel anytime in Settings at least 24 hours before the trial ends.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdarma na %1$@, pak %2$@. Obnovuje se automaticky, dokud ji nezrušíte. Zrušte ji v Nastavení nejméně 24 hodin před koncem zkušební doby."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis i %@, derefter %@. Fornyes automatisk, indtil den opsiges. Opsig når som helst i Indstillinger senest 24 timer før prøveperioden slutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gratis, dann %@. Verlängert sich automatisch bis zur Kündigung. Kündige jederzeit in den Einstellungen, spätestens 24 Stunden vor Ende des Probezeitraums."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δωρεάν για %@, μετά %@. Ανανεώνεται αυτόματα μέχρι να ακυρωθεί. Ακυρώστε στις Ρυθμίσεις τουλάχιστον 24 ώρες πριν τη λήξη της δοκιμής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis durante %@ y luego %@. Se renueva automáticamente hasta que la canceles. Cancela en Ajustes al menos 24 horas antes de que acabe la prueba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmainen %1$@, sitten %2$@. Uusiutuu automaattisesti, kunnes se perutaan. Peru milloin tahansa Asetuksissa viimeistään 24 tuntia ennen kokeilun loppua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit pendant %1$@, puis %2$@. Renouvellement automatique sauf annulation. Annulez à tout moment dans Réglages au moins 24 heures avant la fin de l’essai."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Besplatno %1$@, zatim %2$@. Obnavlja se automatski dok je ne otkažete. Otkažite u Postavkama najmanje 24 sata prije isteka probnog razdoblja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ingyen, utána %@. Lemondásig automatikusan megújul. A Beállításokban bármikor lemondhatod, legalább 24 órával a próbaidő vége előtt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis per %1$@, poi %2$@. Si rinnova automaticamente fino all’annullamento. Annulla in qualsiasi momento in Impostazioni almeno 24 ore prima della fine della prova."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis i %1$@, deretter %2$@. Fornyes automatisk til det sies opp. Si opp når som helst i Innstillinger minst 24 timer før prøveperioden utløper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gratis, daarna %@. Wordt automatisch verlengd tot je opzegt. Zeg op elk moment op in Instellingen, minstens 24 uur voor het einde van de proefperiode."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za darmo przez %1$@, potem %2$@. Odnawia się automatycznie do czasu anulowania. Anuluj w Ustawieniach co najmniej 24 godziny przed końcem okresu próbnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grátis por %@, depois %@. Renova automaticamente até ser cancelada. Cancele nos Ajustes pelo menos 24 horas antes do fim do teste."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Grátis durante %@, depois %@. Renova automaticamente até ser cancelada. Cancele nas Definições pelo menos 24 horas antes do fim do teste."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit %1$@, apoi %2$@. Se reînnoiește automat până la anulare. Anulează oricând în Configurări cu cel puțin 24 de ore înainte de finalul perioadei de probă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатно %1$@, затем %2$@. Подписка продлевается автоматически, пока вы её не отмените. Отмените в Настройках минимум за 24 часа до конца пробного периода."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadarmo na %1$@, potom %2$@. Obnovuje sa automaticky, kým ho nezrušíte. Zrušte ho v Nastaveniach najmenej 24 hodín pred koncom skúšobnej doby."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis i %@, sedan %@. Förnyas automatiskt tills den sägs upp. Avsluta när som helst i Inställningar senast 24 timmar innan provperioden slutar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ücretsiz, sonra %@. İptal edilene kadar otomatik yenilenir. Deneme bitiminden en az 24 saat önce Ayarlar’dan istediğiniz zaman iptal edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безкоштовно %@, далі %@. Поновлюється автоматично до скасування. Скасуйте в Параметрах щонайменше за 24 год до кінця пробного періоду."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bepul, keyin %2$@. Bekor qilinmaguncha avtomatik yangilanadi. Sinov muddati tugashidan kamida 24 soat oldin Sozlamalarda bekor qiling."
          }
        }
      }
    },
