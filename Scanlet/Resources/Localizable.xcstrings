    },
    "Drag to move. Pinch to resize.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posun tažením, velikost sevřením."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk for at flytte. Knib for størrelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe zum Bewegen, zoome zum Skalieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε: μετακίνηση. Τσίμπημα: μέγεθος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve arrastrando y escala pellizcando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä vetämällä. Skaalaa nipistämällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez pour déplacer. Pincez : taille."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povucite za pomak, stisnite za veličinu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd: mozgatás. Csípd: átméretezés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina: sposta. Pizzica: dimensione."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra for å flytte. Knip for å skalere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om te bewegen, knijp om te schalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuwaj palcem, skaluj szczypaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova arrastando e ajuste com 2 dedos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova arrastando e ajuste com 2 dedos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage: mută. Ciupește: redimensionează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите для сдвига. Щипок — размер."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Posun ťahaním, veľkosť zovretím prstov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att flytta, nyp för storlek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürükle: taşı. Kıstır: boyutlandır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тягніть — переміщення. Щипок — розмір."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Suring — siljiydi. Chimdang — o‘lcham."
          }
        }
      }
    },
    "Draw once, place your signature in seconds.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakreslete jednou, podpis vložíte během vteřin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn én gang, og placér din signatur på sekunder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal zeichnen, Signatur in Sekunden einfügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχεδιάστε μία φορά, υπογράψτε σε δευτερόλεπτα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibújala una vez y colócala en segundos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piirrä kerran, lisää allekirjoitus sekunneissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez une fois, placez votre signature en un instant."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nacrtajte jednom, umetnite potpis u sekundi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rajzold meg egyszer, és pillanatok alatt aláírhatsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegnala una volta, inserisci la firma in pochi secondi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn én gang, plasser signaturen på sekunder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén keer tekenen, je handtekening in seconden plaatsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narysuj raz i wstawiaj podpis w kilka sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe uma vez e coloque sua assinatura em segundos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe uma vez e coloque a assinatura em segundos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenează o dată, plasează semnătura în câteva secunde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нарисуйте один раз — ставьте подпись за секунды."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakreslite raz, podpis vložíte za pár sekúnd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rita en gång, placera din signatur på sekunder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez çizin, imzanızı saniyeler içinde yerleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Намалюйте раз — ставте підпис за секунди."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir marta chizing — imzoni soniyalarda qo‘ying."
          }
        }
      }
    },
