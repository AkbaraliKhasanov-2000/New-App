    "Try a sharper scan with good lighting, or pick recognition languages in Settings.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste ostřejší sken při dobrém světle nebo vyberte jazyky rozpoznávání v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv en skarpere scanning i godt lys, eller vælg genkendelsessprog i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche einen schärferen Scan bei gutem Licht oder wähle Erkennungssprachen in den Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δοκιμάστε πιο καθαρή σάρωση με καλό φωτισμό ή επιλέξτε γλώσσες αναγνώρισης στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba con un escaneo más nítido y buena luz, o elige idiomas de reconocimiento en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile terävämpää skannausta hyvässä valossa tai valitse tunnistuskielet Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez un scan plus net avec un bon éclairage, ou choisissez les langues de reconnaissance dans Réglages."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokušajte s oštrijim skenom uz dobro svjetlo ili odaberite jezike prepoznavanja u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Próbálj élesebb beolvasást jó fényben, vagy válassz felismerési nyelveket a Beállításokban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova una scansione più nitida con una buona luce o scegli le lingue di riconoscimento in Impostazioni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv en skarpere skanning i godt lys, eller velg gjenkjenningsspråk i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer een scherpere scan met goed licht, of kies herkenningstalen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrób ostrzejszy skan przy dobrym świetle lub wybierz języki rozpoznawania w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente escanear com mais nitidez e boa luz, ou escolha idiomas de reconhecimento nos Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente uma digitalização mais nítida com boa luz ou escolha os idiomas nas Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încearcă o scanare mai clară, cu lumină bună, sau alege limbile de recunoaștere în Configurări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте более чёткий скан при хорошем освещении или выберите языки распознавания в настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skúste ostrejší sken pri dobrom svetle alebo vyberte jazyky rozpoznávania v Nastaveniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova en skarpare skanning i bra ljus eller välj igenkänningsspråk i Inställningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İyi ışıkta daha net bir tarama deneyin veya Ayarlar’dan tanıma dillerini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скануйте чіткіше при доброму світлі або виберіть мови розпізнавання в Параметрах."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaxshi yorug‘likda aniqroq skanerlang yoki Sozlamalarda aniqlash tillarini tanlang."
          }
        }
      }
    },
