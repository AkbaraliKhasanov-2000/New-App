    "Automatic works for most documents. Choose specific languages to improve accuracy for mixed or uncommon text.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatický režim funguje u většiny dokumentů. Vyberte konkrétní jazyky pro přesnější rozpoznání smíšeného nebo neobvyklého textu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk fungerer til de fleste dokumenter. Vælg bestemte sprog for at øge nøjagtigheden ved blandet eller usædvanlig tekst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Automatisch“ funktioniert bei den meisten Dokumenten. Wähle bestimmte Sprachen, um gemischten oder seltenen Text genauer zu erkennen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «Αυτόματα» λειτουργεί για τα περισσότερα έγγραφα. Επιλέξτε γλώσσες για μεγαλύτερη ακρίβεια σε μικτό ή σπάνιο κείμενο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático sirve para la mayoría de documentos. Elige idiomas concretos para mejorar la precisión en textos mixtos o poco comunes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaattinen toimii useimmille dokumenteille. Valitse tietyt kielet, niin sekakielinen tai harvinainen teksti tunnistuu tarkemmin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode automatique convient à la plupart des documents. Choisissez des langues précises pour mieux lire les textes mixtes ou rares."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatski način radi za većinu dokumenata. Odaberite određene jezike za točnije prepoznavanje miješanog ili neuobičajenog teksta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Automatikus a legtöbb dokumentumnál működik. Vegyes vagy ritka szövegnél válassz nyelveket a pontosabb eredményért."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità automatica va bene per la maggior parte dei documenti. Scegli lingue specifiche per una maggiore precisione con testi misti o rari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk fungerer for de fleste dokumenter. Velg bestemte språk for bedre nøyaktighet med blandet eller uvanlig tekst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch werkt voor de meeste documenten. Kies specifieke talen voor meer nauwkeurigheid bij gemengde of ongebruikelijke tekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb automatyczny sprawdza się w większości dokumentów. Wybierz języki, aby poprawić dokładność dla tekstu mieszanego lub nietypowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático funciona para a maioria dos documentos. Escolha idiomas específicos para mais precisão em textos mistos ou incomuns."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático funciona com a maioria dos documentos. Escolha idiomas específicos para maior precisão em texto misto ou invulgar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Automat funcționează pentru majoritatea documentelor. Alege limbi anume pentru o precizie mai bună la texte mixte sau neobișnuite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматический режим подходит для большинства документов. Выберите языки, чтобы повысить точность для смешанного или редкого текста."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatický režim funguje pri väčšine dokumentov. Vyberte konkrétne jazyky pre presnejšie rozpoznanie zmiešaného alebo nezvyčajného textu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatiskt fungerar för de flesta dokument. Välj specifika språk för bättre precision vid blandad eller ovanlig text."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik çoğu belge için uygundur. Karışık veya nadir metinlerde doğruluğu artırmak için belirli dilleri seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Автоматично» підходить для більшості документів. Виберіть мови, щоб точніше розпізнавати змішаний чи рідкісний текст."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Avtomatik rejim ko‘p hujjatlar uchun mos. Aralash yoki kam uchraydigan matnlarda aniqlikni oshirish uchun tillarni tanlang."
          }
        }
      }
    },
