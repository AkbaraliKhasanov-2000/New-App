    "Everything you need to scan, sign and share documents.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše pro skenování, podepisování a sdílení dokumentů."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ό,τι χρειάζεστε για σάρωση, υπογραφή και κοινοποίηση εγγράφων."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que necesitas para escanear, firmar y compartir documentos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki tarvittava dokumenttien skannaukseen, allekirjoitukseen ja jakoon."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve za skeniranje, potpisivanje i dijeljenje dokumenata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden, ami a dokumentumok beolvasásához, aláírásához és megosztásához kell."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt du trenger for å skanne, signere og dele dokumenter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko, czego potrzebujesz do skanowania, podpisywania i udostępniania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que você precisa para escanear, assinar e compartilhar documentos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que precisa para digitalizar, assinar e partilhar documentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, чтобы сканировать, подписывать и отправлять документы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetko na skenovanie, podpisovanie a zdieľanie dokumentov."
          }
