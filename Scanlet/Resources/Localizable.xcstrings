            "state": "translated",
            "value": "Twoje dokumenty są chronione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus documentos estão protegidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus documentos estão protegidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши документы защищены."
          }
        },
        "sk": {
