    "Your purchase is waiting for approval. Scanlet Pro unlocks automatically once it’s approved.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup čeká na schválení. Scanlet Pro se po schválení odemkne automaticky."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
