    "No active Scanlet Pro subscription was found for this Apple Account.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tento Apple účet nebylo nalezeno aktivní předplatné Scanlet Pro."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκε ενεργή συνδρομή Scanlet Pro για αυτόν τον Λογαριασμό Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado ninguna suscripción activa a Scanlet Pro para esta Apple Account."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tälle Apple-tilille ei löytynyt aktiivista Scanlet Pro ‑tilausta."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ovaj Apple račun nije pronađena aktivna pretplata na Scanlet Pro."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem található aktív Scanlet Pro-előfizetés ehhez az Apple-fiókhoz."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ikke noe aktivt Scanlet Pro-abonnement for denne Apple-kontoen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono aktywnej subskrypcji Scanlet Pro dla tego konta Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma assinatura ativa do Scanlet Pro foi encontrada para esta Conta Apple."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi encontrada nenhuma subscrição ativa do Scanlet Pro para esta Conta Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого Аккаунта Apple не найдено активной подписки Scanlet Pro."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre tento Apple účet sa nenašlo aktívne predplatné Scanlet Pro."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цього облікового запису Apple не знайдено активної підписки Scanlet Pro."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ushbu Apple hisobi uchun faol Scanlet Pro obunasi topilmadi."
          }
        }
      }
    },
