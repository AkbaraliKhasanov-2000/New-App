    "Free exports include a small footer.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezplatné exporty mají malé zápatí."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι δωρεάν εξαγωγές έχουν μικρό υποσέλιδο."
          }
        },
        "es": {
