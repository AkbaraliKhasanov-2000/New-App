    "Copy, translate and share text from any page.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopírujte, překládejte a sdílejte text z libovolné stránky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiér, oversæt og del tekst fra enhver side."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere, übersetze und teile Text von jeder Seite."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντιγράψτε, μεταφράστε και μοιραστείτε κείμενο από κάθε σελίδα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia, traduce y comparte el texto de cualquier página."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopioi, käännä ja jaa tekstiä miltä tahansa sivulta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez, traduisez et partagez le texte de chaque page."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopirajte, prevodite i dijelite tekst s bilo koje stranice."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Másold, fordítsd le és oszd meg bármely oldal szövegét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia, traduci e condividi il testo di qualsiasi pagina."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopier, oversett og del tekst fra hvilken som helst side."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieer, vertaal en deel tekst van elke pagina."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiuj, tłumacz i udostępniaj tekst z każdej strony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie, traduza e compartilhe o texto de qualquer página."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie, traduza e partilhe o texto de qualquer página."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiază, traduce și partajează textul din orice pagină."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копируйте, переводите и отправляйте текст с любой страницы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopírujte, prekladajte a zdieľajte text z ľubovoľnej strany."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiera, översätt och dela text från alla sidor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir sayfadaki metni kopyalayın, çevirin ve paylaşın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копіюйте, перекладайте й поширюйте текст зі сторінок."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Istalgan sahifa matnini nusxalang, tarjima qiling va ulashing."
          }
        }
      }
    },
