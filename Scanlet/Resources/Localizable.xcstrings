    "Add your signature, lock PDFs with a password and share anywhere. Your documents never leave your device.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte podpis, zamkněte PDF heslem a sdílejte kamkoli. Dokumenty nikdy neopustí vaše zařízení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε υπογραφή, κλειδώστε PDF με συνθηματικό και μοιραστείτε τα. Τα έγγραφα δεν φεύγουν από τη συσκευή σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tu firma, protege PDF con contraseña y compártelos donde quieras. Tus documentos nunca salen de tu dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää allekirjoituksesi, lukitse PDF:t salasanalla ja jaa minne tahansa. Dokumenttisi eivät koskaan poistu laitteelta."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte potpis, zaključajte PDF lozinkom i dijelite bilo gdje. Dokumenti nikad ne napuštaju vaš uređaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írd alá, zárold jelszóval a PDF-eket, és oszd meg bárhol. A dokumentumaid nem hagyják el az eszközt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til signaturen din, lås PDF-er med passord og del hvor som helst. Dokumentene dine forlater aldri enheten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodawaj podpis, zabezpieczaj PDF hasłem i udostępniaj wszędzie. Dokumenty nie opuszczają Twojego urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione sua assinatura, proteja PDFs com senha e compartilhe onde quiser. Seus documentos nunca saem do seu aparelho."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione a sua assinatura, proteja PDF com palavra-passe e partilhe onde quiser. Os documentos nunca saem do dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставьте подпись, защищайте PDF паролем и делитесь где угодно. Документы не покидают ваше устройство."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte podpis, zamknite PDF heslom a zdieľajte kdekoľvek. Dokumenty nikdy neopustia vaše zariadenie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додавайте підпис, захищайте PDF паролем і діліться будь-де. Документи не залишають ваш пристрій."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Imzo qo‘ying, PDF’ni parol bilan himoyalang va istalgan joyga ulashing. Hujjatlaringiz qurilmangizdan chiqmaydi."
          }
        }
      }
    },
