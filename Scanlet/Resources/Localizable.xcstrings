          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä laite ei tue dokumenttien skannausta. Voit tuoda kuvia sen sijaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La numérisation n’est pas prise en charge sur cet appareil. Vous pouvez importer des photos à la place."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj uređaj ne podržava skeniranje dokumenata. Umjesto toga možete uvesti fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az eszköz nem támogatja a dokumentumbeolvasást. Helyette fotókat importálhatsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scansione dei documenti non è supportata su questo dispositivo. Puoi invece importare foto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumentskanning støttes ikke på denne enheten. Du kan importere bilder i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Documenten scannen wordt niet ondersteund op dit apparaat. Je kunt in plaats daarvan foto's importeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie nie obsługuje skanowania dokumentów. Zamiast tego możesz importować zdjęcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este aparelho não permite escanear documentos. Você pode importar fotos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não suporta a digitalização de documentos. Pode importar fotos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
