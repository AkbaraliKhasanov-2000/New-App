    "Searchable PDFs let you find and copy text in any PDF app. Text is recognized on your iPhone.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V prohledávatelných PDF najdete a zkopírujete text v jakékoli PDF aplikaci. Text se rozpoznává v iPhonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med søgbare PDF'er kan du finde og kopiere tekst i enhver PDF-app. Teksten genkendes på din iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In durchsuchbaren PDFs kannst du Text in jeder PDF-App finden und kopieren. Der Text wird auf deinem iPhone erkannt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στα PDF με αναζήτηση βρίσκετε και αντιγράφετε κείμενο σε κάθε εφαρμογή PDF. Η αναγνώριση γίνεται στο iPhone σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los PDF con búsqueda te permiten buscar y copiar texto en cualquier app de PDF. El texto se reconoce en tu iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haettavista PDF:istä voit etsiä ja kopioida tekstiä missä tahansa PDF-apissa. Teksti tunnistetaan iPhonella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les PDF interrogeables permettent de trouver et copier du texte dans toute app PDF. Le texte est reconnu sur votre iPhone."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U pretraživom PDF-u tekst možete pronaći i kopirati u bilo kojoj PDF aplikaciji. Tekst se prepoznaje na iPhoneu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kereshető PDF-ekben bármely PDF-appban kereshetsz és másolhatsz szöveget. A felismerés az iPhone-on történik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I PDF ricercabili ti permettono di trovare e copiare il testo in qualsiasi app PDF. Il testo viene riconosciuto sul tuo iPhone."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med søkbare PDF-er kan du finne og kopiere tekst i alle PDF-apper. Teksten gjenkjennes på iPhonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met doorzoekbare PDF's kun je tekst vinden en kopiëren in elke PDF-app. Tekst wordt op je iPhone herkend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W PDF z wyszukiwaniem znajdziesz i skopiujesz tekst w każdej aplikacji PDF. Tekst jest rozpoznawany na iPhonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFs pesquisáveis permitem encontrar e copiar texto em qualquer app de PDF. O texto é reconhecido no seu iPhone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os PDF pesquisáveis permitem encontrar e copiar texto em qualquer app de PDF. O texto é reconhecido no iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF-urile căutabile îți permit să găsești și să copiezi text în orice aplicație PDF. Textul este recunoscut pe iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В PDF с поиском можно находить и копировать текст в любом приложении. Текст распознаётся на вашем iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vo vyhľadávateľných PDF nájdete a skopírujete text v akejkoľvek PDF aplikácii. Text sa rozpoznáva v iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med sökbara PDF:er kan du hitta och kopiera text i alla PDF-appar. Texten känns igen på din iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aranabilir PDF’lerde metni her PDF uygulamasında bulup kopyalayabilirsiniz. Metin iPhone’unuzda tanınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У PDF з пошуком можна шукати й копіювати текст у будь-якій PDF-програмі. Текст розпізнається на iPhone."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qidiriladigan PDF’da matnni istalgan ilovada topish va nusxalash mumkin. Matn iPhone’ingizda aniqlanadi."
          }
        }
      }
    },
