          }
        }
      }
    },
    "Edges are detected and straightened automatically. Documents, receipts, IDs and notes come out crisp and clean.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Okraje se rozpoznají a vyrovnají automaticky. Dokumenty, účtenky, průkazy i poznámky budou ostré a čisté."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι άκρες εντοπίζονται και ισιώνονται αυτόματα. Έγγραφα, αποδείξεις, ταυτότητες και σημειώσεις βγαίνουν καθαρά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los bordes se detectan y enderezan automáticamente. Documentos, recibos, DNI y notas quedan nítidos y limpios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reunat tunnistetaan ja suoristetaan automaattisesti. Dokumentit, kuitit, henkilökortit ja muistiinpanot ovat tarkkoja ja siistejä."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubovi se automatski prepoznaju i ispravljaju. Dokumenti, računi, osobne iskaznice i bilješke ispadaju oštri i čisti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A széleket automatikusan felismeri és kiegyenesíti. A dokumentumok, nyugták, igazolványok és jegyzetek élesek és tiszták lesznek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanter oppdages og rettes opp automatisk. Dokumenter, kvitteringer, ID-kort og notater blir skarpe og rene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krawędzie są wykrywane i prostowane automatycznie. Dokumenty, paragony, dowody i notatki wychodzą ostre i czyste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As bordas são detectadas e endireitadas automaticamente. Documentos, recibos, RG e anotações ficam nítidos e limpos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os contornos são detetados e endireitados automaticamente. Documentos, recibos, cartões e notas ficam nítidos e limpos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Края определяются и выравниваются автоматически. Документы, чеки, удостоверения и заметки получаются чёткими."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Okraje sa rozpoznajú a vyrovnajú automaticky. Dokumenty, bločky, preukazy aj poznámky budú ostré a čisté."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Краї визначаються й вирівнюються автоматично. Документи, чеки, посвідчення й нотатки виходять чіткими й чистими."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Chegaralar avtomatik aniqlanadi va tekislanadi. Hujjatlar, cheklar, ID kartalar va qaydlar tiniq chiqadi."
          }
        }
      }
    },
