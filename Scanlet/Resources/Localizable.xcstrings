    "Document scanning isn’t supported on this device. You can import photos instead.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zařízení nepodporuje skenování dokumentů. Místo toho můžete importovat fotky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning af dokumenter understøttes ikke på denne enhed. Du kan i stedet importere fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Scannen von Dokumenten wird auf diesem Gerät nicht unterstützt. Du kannst stattdessen Fotos importieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σάρωση εγγράφων δεν υποστηρίζεται σε αυτή τη συσκευή. Μπορείτε να εισαγάγετε φωτογραφίες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
