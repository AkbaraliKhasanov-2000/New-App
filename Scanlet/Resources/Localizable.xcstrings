    "Text is recognized on your iPhone, so you can search inside your scans. Nothing is uploaded.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text se rozpoznává v iPhonu, takže můžete prohledávat skeny. Nic se nikam nenahrává."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κείμενο αναγνωρίζεται στο iPhone σας, ώστε να κάνετε αναζήτηση στις σαρώσεις. Τίποτα δεν αποστέλλεται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto se reconoce en tu iPhone para que puedas buscar en tus escaneos. No se sube nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksti tunnistetaan iPhonella, joten voit hakea skannauksistasi. Mitään ei ladata verkkoon."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst se prepoznaje na iPhoneu pa možete pretraživati skenove. Ništa se ne prenosi na internet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szövegfelismerés az iPhone-on történik, így kereshetsz a beolvasásokban. Semmi sem kerül feltöltésre."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksten gjenkjennes på iPhonen, så du kan søke i skanningene dine. Ingenting lastes opp."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst jest rozpoznawany na iPhonie, więc możesz przeszukiwać skany. Nic nie jest wysyłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto é reconhecido no seu iPhone para você buscar nos escaneamentos. Nada é enviado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto é reconhecido no iPhone, para que possa pesquisar nas digitalizações. Nada é enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст распознаётся на iPhone, поэтому можно искать внутри сканов. Ничего не загружается в сеть."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Text sa rozpoznáva v iPhone, takže môžete prehľadávať skeny. Nič sa nikam nenahráva."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст розпізнається на iPhone, тож можна шукати у своїх сканах. Нічого не вивантажується."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Matn iPhone’ingizda aniqlanadi, shuning uchun skanlar ichidan qidirish mumkin. Hech narsa yuklanmaydi."
          }
        }
      }
    },
