    "Scanlet reads text right on your iPhone. Search every scan, copy, translate and create searchable PDFs.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet čte text přímo v iPhonu. Prohledávejte skeny, kopírujte, překládejte a tvořte prohledávatelná PDF."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet læser tekst direkte på din iPhone. Søg i alle scanninger, kopiér, oversæt og opret søgbare PDF'er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet liest Text direkt auf deinem iPhone. Durchsuche jeden Scan, kopiere, übersetze und erstelle durchsuchbare PDFs."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Scanlet διαβάζει κείμενο στο iPhone σας. Αναζητήστε σε κάθε σάρωση, αντιγράψτε, μεταφράστε, φτιάξτε PDF με αναζήτηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet lee el texto en tu iPhone. Busca en todos tus escaneos, copia, traduce y crea PDF con búsqueda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet lukee tekstin suoraan iPhonella. Hae skannauksista, kopioi, käännä ja luo haettavia PDF:iä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet lit le texte directement sur votre iPhone. Cherchez dans chaque scan, copiez, traduisez et créez des PDF interrogeables."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet čita tekst izravno na iPhoneu. Pretražujte skenove, kopirajte, prevodite i izradite pretražive PDF-ove."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Scanlet az iPhone-on ismeri fel a szöveget. Keress a beolvasásokban, másolj, fordíts, és készíts kereshető PDF-et."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet legge il testo direttamente sul tuo iPhone. Cerca in ogni scansione, copia, traduci e crea PDF ricercabili."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet leser tekst rett på iPhonen. Søk i alle skanninger, kopier, oversett og lag søkbare PDF-er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet leest tekst direct op je iPhone. Doorzoek elke scan, kopieer, vertaal en maak doorzoekbare PDF's."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet odczytuje tekst na iPhonie. Przeszukuj skany, kopiuj, tłumacz i twórz PDF z wyszukiwaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Scanlet lê texto no próprio iPhone. Pesquise em tudo, copie, traduza e crie PDFs pesquisáveis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Scanlet lê texto no próprio iPhone. Pesquise em tudo, copie, traduza e crie PDF pesquisáveis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet citește textul direct pe iPhone. Caută în fiecare scanare, copiază, traduce și creează PDF-uri căutabile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet распознаёт текст прямо на iPhone. Ищите по сканам, копируйте, переводите и создавайте PDF с поиском."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet číta text priamo v iPhone. Prehľadávajte skeny, kopírujte, prekladajte a tvorte vyhľadávateľné PDF."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet läser text direkt på din iPhone. Sök i alla skanningar, kopiera, översätt och skapa sökbara PDF:er."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet metni doğrudan iPhone’unuzda okur. Taramalarda arayın, kopyalayın, çevirin ve aranabilir PDF oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet розпізнає текст прямо на iPhone. Шукайте в сканах, копіюйте, перекладайте й створюйте PDF з пошуком."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet matnni to‘g‘ridan-to‘g‘ri iPhone’da o‘qiydi. Skanlar ichidan qidiring, nusxalang, tarjima qiling va qidiriladigan PDF yarating."
          }
        }
      }
    },
