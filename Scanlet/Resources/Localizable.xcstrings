    "Your purchase is waiting for approval. Scanlet Pro unlocks automatically once it’s approved.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup čeká na schválení. Scanlet Pro se po schválení odemkne automaticky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit køb afventer godkendelse. Scanlet Pro låses automatisk op, når det er godkendt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf wartet auf Genehmigung. Scanlet Pro wird automatisch freigeschaltet, sobald er genehmigt ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αγορά σας αναμένει έγκριση. Το Scanlet Pro θα ξεκλειδωθεί αυτόματα μόλις εγκριθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está pendiente de aprobación. Scanlet Pro se desbloqueará automáticamente cuando se apruebe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostosi odottaa hyväksyntää. Scanlet Pro avautuu automaattisesti, kun se on hyväksytty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat est en attente d’approbation. Scanlet Pro sera débloqué automatiquement dès son approbation."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupnja čeka odobrenje. Scanlet Pro otključat će se automatski nakon odobrenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vásárlás jóváhagyásra vár. A Scanlet Pro a jóváhagyás után automatikusan feloldódik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo acquisto è in attesa di approvazione. Scanlet Pro si sbloccherà automaticamente una volta approvato."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet venter på godkjenning. Scanlet Pro låses opp automatisk når det er godkjent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aankoop wacht op goedkeuring. Scanlet Pro wordt automatisch ontgrendeld zodra deze is goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup czeka na zatwierdzenie. Scanlet Pro odblokuje się automatycznie po jego zatwierdzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra está aguardando aprovação. O Scanlet Pro será desbloqueado automaticamente após a aprovação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua compra aguarda aprovação. O Scanlet Pro é desbloqueado automaticamente quando for aprovada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achiziția ta așteaptă aprobarea. Scanlet Pro se deblochează automat după ce este aprobată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка ожидает одобрения. Scanlet Pro откроется автоматически после подтверждения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup čaká na schválenie. Scanlet Pro sa po schválení odomkne automaticky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt köp väntar på godkännande. Scanlet Pro låses upp automatiskt när det har godkänts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma işleminiz onay bekliyor. Onaylandığında Scanlet Pro otomatik olarak açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка очікує схвалення. Scanlet Pro відкриється автоматично після схвалення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xaridingiz tasdiqlanishini kutmoqda. Tasdiqlangach Scanlet Pro avtomatik ochiladi."
          }
        }
      }
    }
  },
  "version": "1.0"
}
