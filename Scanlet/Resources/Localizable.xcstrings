    "Signatures are stored only on this device.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podpisy se ukládají jen v tomto zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaturer gemmes kun på denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaturen werden nur auf diesem Gerät gesichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι υπογραφές αποθηκεύονται μόνο σε αυτή τη συσκευή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las firmas se guardan solo en este dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Allekirjoitukset tallennetaan vain tähän laitteeseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les signatures sont stockées uniquement sur cet appareil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potpisi se spremaju samo na ovom uređaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az aláírásokat csak ez az eszköz tárolja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le firme sono salvate solo su questo dispositivo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaturer lagres bare på denne enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handtekeningen worden alleen op dit apparaat bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podpisy są przechowywane tylko na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As assinaturas ficam salvas apenas neste aparelho."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As assinaturas ficam guardadas apenas neste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Semnăturile sunt stocate doar pe acest dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписи хранятся только на этом устройстве."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podpisy sa ukladajú len v tomto zariadení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaturer sparas endast på den här enheten."
          }
        },
        "tr": {
