    "Scan paper documents, receipts and notes into sharp, searchable PDFs.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenujte dokumenty, účtenky a poznámky do ostrých, prohledávatelných PDF."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σαρώστε έγγραφα, αποδείξεις και σημειώσεις σε καθαρά PDF με αναζήτηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte documentos en papel, recibos y notas en PDF nítidos con búsqueda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Skannaa paperidokumentit, kuitit ja muistiinpanot teräviksi, haettaviksi PDF:iksi."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenirajte dokumente, račune i bilješke u oštre, pretražive PDF-ove."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvasd be a papíralapú dokumentumokat, nyugtákat és jegyzeteket éles, kereshető PDF-be."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skann papirdokumenter, kvitteringer og notater til skarpe, søkbare PDF-er."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanuj dokumenty, paragony i notatki do ostrych PDF z wyszukiwaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie documentos em papel, recibos e anotações em PDFs nítidos e pesquisáveis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitalize documentos em papel, recibos e notas para PDF nítidos e pesquisáveis."
          }
