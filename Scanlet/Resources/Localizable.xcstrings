    "Double-tap to edit this page.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím dvakrát stránku upravíte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγγίξτε δύο φορές για επεξεργασία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para editar la página."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muokkaa sivua kaksoisnapauttamalla."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvaput dodirnite za uređivanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints duplán a szerkesztéshez."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobbelttrykk for å redigere siden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij dwa razy, by edytować stronę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para editar a página."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para editar a página."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь дважды для правки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvojitým klepnutím upravíte stranu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Двічі торкніться, щоб редагувати."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahrirlash uchun ikki marta bosing."
          }
        }
      }
    },
    "Drag to move. Pinch to resize.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posun tažením, velikost sevřením."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε: μετακίνηση. Τσίμπημα: μέγεθος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve arrastrando y escala pellizcando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä vetämällä. Skaalaa nipistämällä."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povucite za pomak, stisnite za veličinu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd: mozgatás. Csípd: átméretezés."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra for å flytte. Knip for å skalere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuwaj palcem, skaluj szczypaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova arrastando e ajuste com 2 dedos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova arrastando e ajuste com 2 dedos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите для сдвига. Щипок — размер."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Posun ťahaním, veľkosť zovretím prstov."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тягніть — переміщення. Щипок — розмір."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Suring — siljiydi. Chimdang — o‘lcham."
          }
        }
      }
    },
    "Draw once, place your signature in seconds.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakreslete jednou, podpis vložíte během vteřin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχεδιάστε μία φορά, υπογράψτε σε δευτερόλεπτα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibújala una vez y colócala en segundos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piirrä kerran, lisää allekirjoitus sekunneissa."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nacrtajte jednom, umetnite potpis u sekundi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rajzold meg egyszer, és pillanatok alatt aláírhatsz."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn én gang, plasser signaturen på sekunder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narysuj raz i wstawiaj podpis w kilka sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe uma vez e coloque sua assinatura em segundos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe uma vez e coloque a assinatura em segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нарисуйте один раз — ставьте подпись за секунды."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakreslite raz, podpis vložíte za pár sekúnd."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Намалюйте раз — ставте підпис за секунди."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir marta chizing — imzoni soniyalarda qo‘ying."
          }
        }
      }
    },
