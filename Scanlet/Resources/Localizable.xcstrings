    "Each page is exported as a separate JPG image.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá stránka se exportuje jako samostatný obrázek JPG."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε σελίδα εξάγεται ως ξεχωριστή εικόνα JPG."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada página se exporta como una imagen JPG independiente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen sivu viedään erillisenä JPG-kuvana."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka stranica izvozi se kao zasebna JPG slika."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden oldal külön JPG-képként lesz exportálva."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver side eksporteres som et eget JPG-bilde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda strona jest eksportowana jako osobny plik JPG."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada página é exportada como uma imagem JPG separada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada página é exportada como uma imagem JPG separada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая страница экспортируется отдельным JPG."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá strana sa exportuje ako samostatný obrázok JPG."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна сторінка експортується як окреме зображення JPG."
