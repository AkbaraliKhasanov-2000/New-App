            "value": "Dvaput dodirnite za uređivanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints duplán a szerkesztéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca due volte per modificarla."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobbelttrykk for å redigere siden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik dubbel om deze pagina te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij dwa razy, by edytować stronę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para editar a página."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para editar a página."
          }
        },
        "ro": {
