    "Document scanning isn’t supported on this device. You can import photos instead.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zařízení nepodporuje skenování dokumentů. Místo toho můžete importovat fotky."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σάρωση εγγράφων δεν υποστηρίζεται σε αυτή τη συσκευή. Μπορείτε να εισαγάγετε φωτογραφίες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no permite escanear documentos. Puedes importar fotos en su lugar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä laite ei tue dokumenttien skannausta. Voit tuoda kuvia sen sijaan."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj uređaj ne podržava skeniranje dokumenata. Umjesto toga možete uvesti fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az eszköz nem támogatja a dokumentumbeolvasást. Helyette fotókat importálhatsz."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumentskanning støttes ikke på denne enheten. Du kan importere bilder i stedet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie nie obsługuje skanowania dokumentów. Zamiast tego możesz importować zdjęcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
