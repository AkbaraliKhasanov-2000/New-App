            "state": "translated",
            "value": "Az ingyenes exportokon kis lábléc van."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis eksporter har en liten bunntekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Darmowe eksporty mają małą stopkę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportações grátis têm um pequeno rodapé."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportações grátis têm um pequeno rodapé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В бесплатных экспортах есть небольшая подпись."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezplatné exporty majú malú pätu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
