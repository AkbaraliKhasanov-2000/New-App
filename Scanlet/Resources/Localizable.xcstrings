    "Document scanning isn’t supported on this device. You can import photos instead.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирование документов не поддерживается на этом устройстве. Вместо этого можно импортировать фото."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qurilmada hujjat skanerlash qo‘llab-quvvatlanmaydi. Buning o‘rniga rasmlarni import qilishingiz mumkin."
          }
        }
      }
    },
