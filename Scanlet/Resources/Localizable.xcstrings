    "Upgrade to Scanlet Pro for unlimited text recognition, searchable PDFs and more.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejděte na Scanlet Pro pro neomezené rozpoznávání textu, prohledávatelná PDF a další."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgrader til Scanlet Pro for ubegrænset tekstgenkendelse, søgbare PDF'er og mere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade auf Scanlet Pro für unbegrenzte Texterkennung, durchsuchbare PDFs und mehr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναβαθμίστε σε Scanlet Pro για απεριόριστη αναγνώριση κειμένου, PDF με αναζήτηση και άλλα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejora a Scanlet Pro y obtén reconocimiento de texto ilimitado, PDF con búsqueda y mucho más."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivitä Scanlet Prohon, niin saat rajattoman tekstintunnistuksen, haettavat PDF:t ja paljon muuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez à Scanlet Pro pour la reconnaissance de texte illimitée, les PDF interrogeables et plus."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijeđite na Scanlet Pro za neograničeno prepoznavanje teksta, pretražive PDF-ove i više."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válts Scanlet Pro-ra a korlátlan szövegfelismerésért, a kereshető PDF-ekért és még sok másért."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa a Scanlet Pro per riconoscimento testo illimitato, PDF ricercabili e altro."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgrader til Scanlet Pro for ubegrenset tekstgjenkjenning, søkbare PDF-er og mer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade naar Scanlet Pro voor onbeperkte tekstherkenning, doorzoekbare PDF's en meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejdź na Scanlet Pro, by rozpoznawać tekst bez limitu, tworzyć PDF z wyszukiwaniem i więcej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assine o Scanlet Pro para ter reconhecimento ilimitado de texto, PDFs pesquisáveis e mais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe para Scanlet Pro para ter reconhecimento ilimitado de texto, PDF pesquisáveis e mais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Treci la Scanlet Pro pentru recunoaștere text nelimitată, PDF-uri căutabile și altele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдите на Scanlet Pro для безлимитного распознавания текста, PDF с поиском и многого другого."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prejdite na Scanlet Pro pre neobmedzené rozpoznávanie textu, vyhľadávateľné PDF a ďalšie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppgradera till Scanlet Pro för obegränsad textigenkänning, sökbara PDF:er och mer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırsız metin tanıma, aranabilir PDF’ler ve daha fazlası için Scanlet Pro’ya yükseltin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдіть на Scanlet Pro: необмежене розпізнавання тексту, PDF з пошуком та інше."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheksiz matn aniqlash, qidiriladigan PDF va boshqa imkoniyatlar uchun Scanlet Pro’ga o‘ting."
          }
        }
      }
    },
