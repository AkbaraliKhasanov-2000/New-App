{
  "sourceLanguage": "en",
  "strings": {
    "%@ Copy": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (копия)"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (nusxa)"
          }
        }
      }
    },
    "%@ free": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ бесплатно"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bepul"
          }
        }
      }
    },
    "%@ free, then %@/%@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ бесплатно, затем %2$@/%3$@"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bepul, keyin %2$@/%3$@"
          }
        }
      }
    },
    "%@. Renews automatically until canceled. Cancel anytime in Settings at least 24 hours before the period ends.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Подписка продлевается автоматически, пока вы её не отмените. Отмените в Настройках минимум за 24 часа до конца периода."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Bekor qilinmaguncha avtomatik yangilanadi. Davr tugashidan kamida 24 soat oldin Sozlamalarda bekor qiling."
          }
        }
      }
    },
    "%@/%@, cancel anytime": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@/%2$@, отмена в любой момент"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@/%2$@, istalgan vaqtda bekor qilish mumkin"
          }
        }
      }
    },
