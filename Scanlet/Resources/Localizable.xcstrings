    "Your documents are protected.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše dokumenty jsou chráněné."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα έγγραφά σας προστατεύονται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus documentos están protegidos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumenttisi ovat suojattuja."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši dokumenti su zaštićeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A dokumentumaid védve vannak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumentene dine er beskyttet."
          }
        },
        "pl": {
