    "Drag to move. Pinch to resize.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите для перемещения. Сведите пальцы для изменения размера."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Siljitish uchun torting. O‘lchamni o‘zgartirish uchun chimchilang."
          }
        }
      }
    },
    "Draw once, place your signature in seconds.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нарисуйте один раз — ставьте подпись за секунды."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir marta chizing — imzoni soniyalarda qo‘ying."
          }
        }
      }
    },
