{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet uses the camera to scan your documents."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet používá fotoaparát ke skenování dokumentů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet bruger kameraet til at scanne dine dokumenter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet verwendet die Kamera, um deine Dokumente zu scannen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Scanlet χρησιμοποιεί την κάμερα για τη σάρωση των εγγράφων σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet usa la cámara para escanear tus documentos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet käyttää kameraa dokumenttien skannaamiseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet utilise l’appareil photo pour numériser vos documents."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet koristi kameru za skeniranje dokumenata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Scanlet a kamerát a dokumentumok beolvasására használja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet usa la fotocamera per scansionare i tuoi documenti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet bruker kameraet til å skanne dokumentene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet gebruikt de camera om je documenten te scannen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet używa aparatu do skanowania dokumentów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Scanlet usa a câmera para escanear seus documentos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Scanlet usa a câmara para digitalizar os seus documentos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet folosește camera pentru a-ți scana documentele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet использует камеру для сканирования документов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet používa kameru na skenovanie dokumentov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet använder kameran för att skanna dina dokument."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet, belgelerinizi taramak için kamerayı kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet використовує камеру для сканування документів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet hujjatlaringizni skanerlash uchun kameradan foydalanadi."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet uses Face ID to keep your documents private."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet používá Face ID k ochraně vašich dokumentů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet bruger Face ID til at holde dine dokumenter private."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet verwendet Face ID, um deine Dokumente privat zu halten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Scanlet χρησιμοποιεί το Face ID για να κρατά τα έγγραφά σας ιδιωτικά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet usa Face ID para mantener tus documentos en privado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet käyttää Face ID:tä dokumenttiesi suojaamiseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet utilise Face ID pour protéger la confidentialité de vos documents."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet koristi Face ID za zaštitu vaših dokumenata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Scanlet a Face ID-t a dokumentumaid védelmére használja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet usa Face ID per mantenere privati i tuoi documenti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet bruker Face ID for å holde dokumentene dine private."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet gebruikt Face ID om je documenten privé te houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet używa Face ID, aby chronić Twoje dokumenty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Scanlet usa o Face ID para manter seus documentos privados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Scanlet usa o Face ID para manter os seus documentos privados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet folosește Face ID pentru a-ți păstra documentele private."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet использует Face ID для защиты ваших документов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet používa Face ID na ochranu vašich dokumentov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet använder Face ID för att hålla dina dokument privata."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet, belgelerinizi gizli tutmak için Face ID’yi kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet використовує Face ID для захисту ваших документів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanlet hujjatlaringizni himoyalash uchun Face ID’dan foydalanadi."
          }
        }
      }
