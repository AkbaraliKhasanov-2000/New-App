{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse uses the camera to scan your documents."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse používá fotoaparát ke skenování dokumentů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse bruger kameraet til at scanne dine dokumenter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse verwendet die Kamera, um deine Dokumente zu scannen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Scanmuse χρησιμοποιεί την κάμερα για τη σάρωση των εγγράφων σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse usa la cámara para escanear tus documentos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse käyttää kameraa dokumenttien skannaamiseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse utilise l’appareil photo pour numériser vos documents."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse koristi kameru za skeniranje dokumenata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Scanmuse a kamerát a dokumentumok beolvasására használja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse usa la fotocamera per scansionare i tuoi documenti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse bruker kameraet til å skanne dokumentene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse gebruikt de camera om je documenten te scannen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse używa aparatu do skanowania dokumentów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Scanmuse usa a câmera para escanear seus documentos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Scanmuse usa a câmara para digitalizar os seus documentos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse folosește camera pentru a-ți scana documentele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse использует камеру для сканирования документов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse používa kameru na skenovanie dokumentov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse använder kameran för att skanna dina dokument."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse, belgelerinizi taramak için kamerayı kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse використовує камеру для сканування документів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse hujjatlaringizni skanerlash uchun kameradan foydalanadi."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse uses Face ID to keep your documents private."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse používá Face ID k ochraně vašich dokumentů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse bruger Face ID til at holde dine dokumenter private."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse verwendet Face ID, um deine Dokumente privat zu halten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Scanmuse χρησιμοποιεί το Face ID για να κρατά τα έγγραφά σας ιδιωτικά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse usa Face ID para mantener tus documentos en privado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse käyttää Face ID:tä dokumenttiesi suojaamiseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse utilise Face ID pour protéger la confidentialité de vos documents."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse koristi Face ID za zaštitu vaših dokumenata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Scanmuse a Face ID-t a dokumentumaid védelmére használja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse usa Face ID per mantenere privati i tuoi documenti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse bruker Face ID for å holde dokumentene dine private."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse gebruikt Face ID om je documenten privé te houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse używa Face ID, aby chronić Twoje dokumenty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Scanmuse usa o Face ID para manter seus documentos privados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Scanmuse usa o Face ID para manter os seus documentos privados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse folosește Face ID pentru a-ți păstra documentele private."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse использует Face ID для защиты ваших документов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse používa Face ID na ochranu vašich dokumentov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse använder Face ID för att hålla dina dokument privata."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse, belgelerinizi gizli tutmak için Face ID’yi kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse використовує Face ID для захисту ваших документів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanmuse hujjatlaringizni himoyalash uchun Face ID’dan foydalanadi."
          }
        }
      }
